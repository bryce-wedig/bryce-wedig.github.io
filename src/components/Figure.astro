---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { responsive } from '@lib/images';

interface Props {
  /** Figure number shown in bold before the caption. */
  n?: string | number;
  /** An image imported at the top of the MDX file. */
  src: ImageMetadata;
  alt: string;
  /** May contain inline HTML. */
  caption?: string;
}

const { n, src, alt, caption } = Astro.props;
---

<figure class="figure">
  <Image src={src} alt={alt} {...responsive(src, [800, 1400])} sizes="(max-width: 900px) 100vw, 720px" />
  {
    caption && (
      <figcaption>
        {n && <b>Figure {n}.</b>}{' '}
        <Fragment set:html={caption} />
      </figcaption>
    )
  }
</figure>
